PORT=3000
JWT_SECRET=your_super_secret_key_here_min_32_chars
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
NODE_ENV=development

# Supabase Postgres (via Prisma / pg pool) — usar el pooler con pgbouncer=true
DATABASE_URL=postgresql://postgres.[project_ref]:[password]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3
DIRECT_URL=postgresql://postgres.[project_ref]:[password]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Supabase Storage (imagenes de lugares) — SIEMPRE service_role, nunca anon_key
SUPABASE_URL=https://[project_ref].supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role_key...
SUPABASE_BUCKET=places-images

# Firebase Admin SDK (push FCM — notificaciones diarias por municipio)
# Sin estas 3 variables, sendDailyNotifications() se desactiva en silencio (console.warn, no revienta el servidor)
FIREBASE_PROJECT_ID=nombre-de-tu-proyecto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@nombre-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\ntu_clave_privada_aqui\n-----END RSA PRIVATE KEY-----\n"

# Dual-write (migracion SQLite -> Postgres, desactivar cuando termine)
DUAL_WRITE_ENABLED=false
DUAL_WRITE_STRICT=false
DUAL_WRITE_LOG_SUCCESS=false
# Solo requerido si DUAL_WRITE_ENABLED=true
POSTGRES_URL=postgresql://usuario:password@host:5432/dbname
